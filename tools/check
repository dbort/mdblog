#!/usr/bin/env bash
#
# The merge gate's contract is in .claude/docs/pipeline.md § Checks. Steps live in
# tools/check_runner.py.
set -e

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

if ! command -v pixi >/dev/null 2>&1; then
    echo "tools/check: pixi not found on PATH; install it from https://pixi.sh" >&2
    exit 127
fi

# --locked fails on a pixi.lock that is out of date with pixi.toml.
exec pixi run --locked --manifest-path "$repo/pixi.toml" \
    python "$repo/tools/check_runner.py" "$@"
